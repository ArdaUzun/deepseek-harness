# Copy to .env.linux (Git ignored). Use UTF-8; values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Optional HTTPS directory the AppImage checks for nightly-linux.yml (nightly-linux-arm64.yml on arm64).
# A GitHub repository that publishes each build as its latest release can use:
# DSH_DESKTOP_LINUX_UPDATE_URL=https://github.com/<owner>/<repository>/releases/latest/download/

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
